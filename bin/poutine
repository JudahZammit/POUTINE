#!/bin/sh
# poutine: run POUTINE from any directory (see docs/launcher.md).
# Needs Java 21+ and treetime on PATH (activate the conda environment) and the jar built with "mvn package".
# Extra JVM options can be given in POUTINE_JAVA_OPTS, for example POUTINE_JAVA_OPTS="-Xmx16g".

die() {
    echo "poutine: $*" >&2
    exit 1
}

# The jar is in ../target relative to this script; readlink -f makes this work through symlinks too.
dir=$(dirname "$(readlink -f "$0")")
jar=
for f in "$dir"/../target/poutine-*.jar; do [ -f "$f" ] && jar=$f; done
[ -n "$jar" ] || die "jar not found: build it with 'mvn package' inside the conda environment (see docs/environment.md)."

command -v java > /dev/null || die "java not found: activate the conda environment (conda activate poutine)."
major=$(java -version 2>&1 | sed -n 's/.* version "\([0-9]*\).*/\1/p' | head -n 1)
[ "${major:-0}" -ge 21 ] || die "Java 21 or newer is required (found ${major:-none}): activate the conda environment (conda activate poutine)."

# POUTINE_JAVA_OPTS is deliberately unquoted so that several options can be given.
# shellcheck disable=SC2086
exec java ${POUTINE_JAVA_OPTS:-} -jar "$jar" "$@"
